# ── Web UI protection (strongly recommended when running publicly) ──────────
# If both are set, the browser will prompt for credentials.
# Leave blank to disable auth (fine for local / trusted network use).
APP_USER=admin
APP_PASSWORD=change-me-please

# ── Database ────────────────────────────────────────────────────────────────
# Path inside the container — mapped to ./data/ on the host via docker-compose
DB_PATH=/app/data/redsignal.db

# ── Anthropic API key (optional fallback) ───────────────────────────────────
# You can also add AI keys per-listener inside the app under Vault.
# Setting it here makes it the global default when no key is assigned.
ANTHROPIC_API_KEY=
